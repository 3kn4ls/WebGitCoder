# Configuración de despliegue para WebGitCoder

# Tag de la imagen Docker (default: latest)
IMAGE_TAG=latest

# Puerto del registry local (default: 5000)
REGISTRY_PORT=5000

# Namespace de Kubernetes (default: webgitcoder)
NAMESPACE=webgitcoder

# Hostname para Ingress (default: webgitcoder.local)
INGRESS_HOST=webgitcoder.local

# Número de réplicas (default: 2)
REPLICAS=2

# Recursos - Memory Request (default: 128Mi)
MEMORY_REQUEST=128Mi

# Recursos - Memory Limit (default: 512Mi)
MEMORY_LIMIT=512Mi

# Recursos - CPU Request (default: 100m)
CPU_REQUEST=100m

# Recursos - CPU Limit (default: 500m)
CPU_LIMIT=500m
